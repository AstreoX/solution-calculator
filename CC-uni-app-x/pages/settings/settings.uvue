<template>
	<view class="set-page">
		<scroll-view class="set-scroller" direction="vertical" :show-scrollbar="false">
			<view class="set-content" :style="{ paddingTop: topPad + 'px' }">
				<set-header title="设置"></set-header>

				<text class="grp">识别与建议</text>
				<view class="card menu">
					<view class="mrow" @click="open('model')">
						<view class="mic">
							<image class="ico20" src="/static/icons/spark-1F5FAD.svg"></image>
						</view>
						<view class="mtx">
							<text class="sw-t">模型供应商</text>
							<text :class="['lbl', 'ell', ready ? '' : 'c-amber']">{{ modelSub }}</text>
						</view>
						<image class="chev" src="/static/icons/chevr-8C959C.svg"></image>
					</view>
				</view>

				<text class="grp">关于</text>
				<view class="card menu">
					<view class="mrow" @click="open('about')">
						<view class="mic">
							<image class="ico20" src="/static/icons/bell-1F5FAD.svg"></image>
						</view>
						<view class="mtx">
							<text class="sw-t">版本与公告</text>
							<text :class="['lbl', upd.hasUpdate ? 'c-blue' : '']">{{ aboutSub }}</text>
						</view>
						<view v-if="upd.hasUpdate || upd.unread > 0" class="mdot"></view>
						<image class="chev" src="/static/icons/chevr-8C959C.svg"></image>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { PRESETS, vlm, vlmReady } from '@/common/settings.uts'
	import { upd } from '@/common/update.uts'

	const win = uni.getWindowInfo()
	const topPad = Math.max(56, win.statusBarHeight + 9)

	const ready = computed(() : boolean => vlmReady())

	const modelSub = computed(() : string => {
		let name = '自定义'
		for (let i = 0; i < PRESETS.length; i++) if (PRESETS[i].id == vlm.preset) name = PRESETS[i].name
		if (!vlmReady()) return name + ' · 未填写 API Key'
		// 只显示模型名最后一段（去掉 deepseek/ 之类的厂商前缀）
		const parts = vlm.model.split('/')
		return name + ' · ' + parts[parts.length - 1]
	})

	const aboutSub = computed(() : string => {
		const cur = '当前版本 ' + (upd.curName.length > 0 ? upd.curName : '—')
		const r = upd.latest
		if (upd.hasUpdate && r != null) return cur + ' · 新版本 ' + r.versionName
		if (upd.unread > 0) return cur + ' · ' + upd.unread.toFixed(0) + ' 条新公告'
		return cur
	})

	function open(p : string) {
		uni.navigateTo({ url: '/pages/settings/' + p })
	}
</script>

<style>
	.grp {
		margin-top: 20px;
		margin-bottom: 8px;
		padding-left: 4px;
		font-family: ns5;
		font-size: 13px;
		line-height: 19px;
		color: #62686C;
	}

	.menu {
		padding: 0 16px;
	}

	.mrow {
		flex-direction: row;
		align-items: center;
		height: 68px;
	}

	.mrow-sep {
		border-top: 1px solid #E6E8E3;
	}

	.mic {
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background-color: #E3ECF7;
		align-items: center;
		justify-content: center;
	}

	.mtx {
		flex: 1;
		margin-left: 12px;
		overflow: hidden;
	}

	.ell {
		lines: 1;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.sw-t {
		font-family: ns5;
		font-size: 15px;
		line-height: 21px;
		color: #16191B;
	}

	.mdot {
		width: 8px;
		height: 8px;
		border-radius: 4px;
		background-color: #1F5FAD;
		margin-right: 8px;
	}

	.chev {
		width: 16px;
		height: 16px;
	}
</style>
